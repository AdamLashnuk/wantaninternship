INTERNSHIPS_API_URL=https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com/internships

# From the AWS stack outputs after deploying the Cognito account resources.
COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=YOUR_ACCOUNTS_CLIENT_ID

# Optional: billing otherwise uses INTERNSHIPS_API_URL's origin and base path.
# BILLING_API_URL=https://YOUR_API_ID.execute-api.YOUR_REGION.amazonaws.com/billing
# Stripe keys, price ID, webhook signing secret and free-access code hash are AWS SAM parameters.

# Optional override; otherwise derived from INTERNSHIPS_API_URL by replacing /internships with /settings
# SETTINGS_API_URL=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/settings

# Optional SEO verification and consent-based public-page analytics (Vercel frontend).
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
